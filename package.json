    "@types/node": "^20.10.6",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^2.4.5",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.70.0"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "micro-router": "^1.0.1",
